---
import {getCollection,render} from 'astro:content';
import Docs from '../layouts/Docs.astro';
export async function getStaticPaths(){return(await getCollection('docs')).map(entry=>({params:{slug:entry.id.replace(/\/index$/,'')},props:{entry}}))}
const {entry}=Astro.props;
const {Content,headings}=await render(entry);
---
<Docs title={entry.data.title} description={entry.data.description} path={entry.id} headings={entry.data.sourceHeadings||headings}><Content/></Docs>
