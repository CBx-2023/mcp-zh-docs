---
import {getEntry,render} from 'astro:content';
import Docs from '../layouts/Docs.astro';
const entry=await getEntry('docs','docs/2026-07-28/getting-started/intro');
if(!entry)throw new Error('Missing intro translation');
const {Content,headings}=await render(entry);
---
<Docs title={entry.data.title} description={entry.data.description} path={entry.id} headings={headings}><Content/></Docs>
