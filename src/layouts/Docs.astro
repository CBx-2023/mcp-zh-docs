---
import '@fontsource-variable/inter';
import '../styles/official.css';
import Icon from '../components/Icon.astro';
import Search from '../components/Search.astro';
import {sections,sectionFor,local,base} from '../lib/navigation';
import source from '../../upstream/manifest.json';
import site from '../../content/site.json';
interface Props {title:string;path:string;description?:string;headings:{depth:number;slug:string;text:string}[];}
const {title,path,description='',headings=[]}=Astro.props;
const currentSection=sectionFor(path);
const groups=sections[currentSection].groups;
type NavItem={path?:string;children?:NavItem[]};
const hasPath=(items:NavItem[]):boolean=>items.some(i=>i.path===path||(i.children&&hasPath(i.children)));
const group=groups.find(g=>hasPath(g.items))?.title||'文档';
const sample=site.pages.some(p=>p.path===path);
const toc=headings.filter(h=>h.depth>=2&&h.depth<=(path.endsWith('architecture')?3:2));
const pages=site.pages.filter(p=>(p.section||'docs')===currentSection);
const index=pages.findIndex(p=>p.path===path);
const prev=pages[index-1],next=pages[index+1];
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
 <title>{title} - MCP 中文文档</title><meta name="description" content={description}/>
 <link rel="canonical" href={`https://docs.starlandai.com${local(path)}/`}/>
 <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}/>
 <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
 <meta property="og:type" content="article"/><meta property="og:locale" content="zh_CN"/>
 <script is:inline>try{const t=localStorage.getItem('mcp-theme');document.documentElement.dataset.theme=t==='dark'||(!t&&matchMedia('(prefers-color-scheme:dark)').matches)?'dark':'light'}catch{}</script>
</head>
<body>
 <a href="#content-area" class="skip-link">跳到正文</a>
 <header id="navbar">
  <div class="topbar">
   <button class="icon-button mobile-menu" aria-label="打开导航" aria-expanded="false"><Icon name="menu"/></button>
   <a href={local('')} class="brand" aria-label="MCP 中文文档首页"><img class="light-logo" src={`${base}/logo/light.svg`} alt="Model Context Protocol"/><img class="dark-logo" src={`${base}/logo/dark.svg`} alt="Model Context Protocol"/></a>
   <details class="version-picker"><summary>2026-07-28（最新）<Icon name="down" size={14}/></summary><div><strong>简体中文 · 非官方译本</strong><span>2026-07-28</span><a href="https://modelcontextprotocol.io/docs/2026-07-28/" target="_blank" rel="noreferrer">查看官方版本 ↗</a></div></details>
   <button class="search-trigger" data-open-search aria-label="搜索文档"><Icon name="search" size={16}/><span>搜索...</span><kbd>⌘ K</kbd></button>
   <a class="assistant-link" href={`https://modelcontextprotocol.io/${path}`} target="_blank" rel="noreferrer"><Icon name="sparkles" size={17}/>官方助手<Icon name="external" size={12}/></a>
   <nav class="top-links" aria-label="外部链接"><a href="https://blog.modelcontextprotocol.io/">Blog</a><a href="https://github.com/CBx-2023/mcp-zh-docs">GitHub</a><a href="https://discord.gg/6CSzBmMkjX">Discord</a></nav>
   <button class="icon-button theme-toggle" aria-label="切换明暗主题"><Icon name="monitor" size={18}/></button>
  </div>
  <nav class="section-tabs" aria-label="主要导航">
   {Object.entries(sections).map(([key,section])=><a class:list={[{active:currentSection===key}]} href={local(section.entry)}>{section.label}</a>)}<a href="https://modelcontextprotocol.io/registry/about">Registry</a><a href="https://modelcontextprotocol.io/seps">SEPs</a><a href="https://modelcontextprotocol.io/community/contributing">社区</a>
  </nav>
 </header>
 <div class="mobile-backdrop"></div>
 <div class="docs-shell">
  <aside id="sidebar" aria-label="文档导航">
   {groups.map(g=><section><h3>{g.title}</h3><ul>{g.items.map(item=><li>{'children'in item?<details><summary>{item.label}<Icon name="chevron" size={12}/></summary><ul>{item.children.map(child=><li><a href={local(child.path)}>{child.label}</a></li>)}</ul></details>:<a href={local(item.path)} aria-current={item.path===path?'page':undefined}>{item.label}</a>}</li>)}</ul></section>)}
   <div class="sidebar-about"><a href={local('translation-guide')}>翻译约定与进度 <Icon name="external" size={12}/></a><span>{site.pages.length} 篇中文译文 · 2026-07-28</span></div>
  </aside>
  <main id="content-area" class="doc-main" data-pagefind-body>
   <div class="page-group">{group}</div>
   <div class="page-heading"><h1 id="page-title" data-pagefind-meta="title">{title}</h1><button class="copy-page" aria-label="复制页面" data-copy-url={sample?`${local(path)}.md`:undefined}><Icon name="copy" size={16}/><span>复制页面</span></button></div>
   <div id="doc-content" class="mdx-content"><slot/></div>
   {sample&&<div class="translation-attribution" data-pagefind-ignore><span>非官方简体中文译本</span><a href={`https://modelcontextprotocol.io/${path}`}>英文原文 ↗</a><a href={`https://github.com/modelcontextprotocol/modelcontextprotocol/tree/${source.commit}`}>源码 {source.commit.slice(0,7)}</a></div>}
   <nav class="pagination" aria-label="翻页" data-pagefind-ignore>{prev?<a href={local(prev.path)}><span>← 上一篇</span><strong>{prev.label}</strong></a>:<span/>}{next&&<a class="next" href={local(next.path)}><span>下一篇 →</span><strong>{next.label}</strong></a>}</nav>
   <footer data-pagefind-ignore><div><a href="https://github.com/CBx-2023/mcp-zh-docs">GitHub</a><a href="https://discord.gg/6CSzBmMkjX">Discord</a></div><p>原文 © Model Context Protocol 及其贡献者。<br/>非官方简体中文译本 · <a href={local('translation-guide')}>翻译说明</a> · <a href={`${base}/upstream-license.txt`}>原文许可</a></p></footer>
  </main>
  <aside class="page-toc" aria-label="本页内容"><div class="toc-label"><Icon name="toc" size={14}/>本页内容</div><ul>{toc.map(h=><li class:list={[`depth-${h.depth}`]}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></aside>
 </div>
 <Search/>
 <script src="../scripts/docs.ts"/>
</body>
</html>
