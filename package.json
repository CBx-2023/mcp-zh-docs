{
  "name": "mcp-zh-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && astro dev --host 127.0.0.1",
    "check:translations": "node scripts/validate.mjs",
    "build": "npm run check:translations && node scripts/prepare.mjs && astro build && pagefind --site dist --glob '{docs/**/*.html,specification/**/*.html,extensions/**/*.html,examples/index.html,translation-guide/index.html}' && node scripts/check-site.mjs && node scripts/package.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/starlight": "0.42.7",
    "@fontsource-variable/inter": "5.2.8",
    "@pagefind/default-ui": "1.3.0",
    "astro": "7.4.2",
    "astro-expressive-code": "0.44.0",
    "mermaid": "12.2.0",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@types/node": "^26.0.0",
    "cheerio": "1.2.0",
    "github-slugger": "2.0.0",
    "js-yaml": "4.3.2",
    "mdast-util-to-string": "4.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "wrangler": "4.154.0"
  }
}
